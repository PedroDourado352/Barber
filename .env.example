# Supabase — copie este arquivo para ".env" e preencha com as chaves do seu projeto.
# Onde encontrar: Supabase Dashboard > Project Settings > API
#   - Project URL      -> VITE_SUPABASE_URL
#   - Project API keys > "anon public" -> VITE_SUPABASE_ANON_KEY
# A chave "anon" é pública (pode ir para o front-end). NUNCA use a "service_role" aqui.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
